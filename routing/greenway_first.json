{
  "priority": [
    { "if": "road_class == CYCLEWAY", "multiply_by": "1.6" },
    { "if": "bike_network != OTHER", "multiply_by": "1.3" },
    { "if": "(road_class == RESIDENTIAL || road_class == LIVING_STREET) && max_speed <= 40", "multiply_by": "1.2" },
    { "if": "road_class == TERTIARY", "multiply_by": "0.9" },
    { "if": "road_class == SECONDARY", "multiply_by": "0.7" },
    { "if": "road_class == PRIMARY", "multiply_by": "0.5" },
    { "if": "road_class == TRUNK", "multiply_by": "0.3" }
  ]
}
